; Проект-пример к видеоинструкции AstraForge «Игровой уровень с нуля».
; Godot 4.5.1, Forward+ для 3D, 2D-сцена в том же проекте. Без плагинов.

config_version=5

[application]

config/name="AstraForge - Уровень с нуля (демо)"
run/main_scene="res://scenes/level_v3.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=3
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=4
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0.55, 0.7, 0.82, 1)

[editor]

movie_writer/mjpeg_quality=0.95
